    {
      "name": "9. Record Widget Event Analytics",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"actionCode\": \"USER_SCHEDULE_TOUR_SCHEDULED_CONFIRMATION_POPUP_CLICK\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/analytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "analytics"
          ]
        },
        "description": "Public endpoint to record widget analytics event action codes."
      },
      "response": []
    }
  ]
