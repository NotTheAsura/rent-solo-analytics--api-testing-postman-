        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateFromFilter\": \"\",\n  \"dateToFilter\": \"\",\n  \"page\": \"1\",\n  \"limit\": \"10\",\n  \"search\": \"\",\n  \"sortField\": \"createdAt\",\n  \"sortOrder\": \"desc\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/getAnalyticsRentersList",
          "host": [
