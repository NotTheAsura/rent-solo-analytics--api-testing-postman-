{
  "info": {
    "_postman_id": "rentsolo-analytics-api-v1",
    "name": "RentSolo - Analytics Page APIs",
    "description": "Collection containing all backend endpoints powering the Agent Analytics Dashboard in RentSolo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{your_token_here}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:9090",
      "type": "string",
      "description": "Base URL of backend server"
    }
  ],
  "item": [
    {
      "name": "1. Tour Analytics Overview",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"dateFromFilter\": \"\",\n  \"dateToFilter\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/tourAnalytics",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent",
            "tourAnalytics"
          ]
        },
        "description": "Fetches overall tour analytics stats including widget clicks, booked tours, completed tours, and key insights."
      },
      "response": []
    },
    {
      "name": "2. Tour Analytics Details - Widget Clicks",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"key\": \"widgetClick\",\n  \"dateFromFilter\": \"\",\n  \"dateToFilter\": \"\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/agent/tourAnalyticsDetails",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "agent",
            "tourAnalyticsDetails"
          ]
        },
        "description": "Fetches detailed breakdown for Widget Clicks tab."
      },
      "response": []
    },
